#lob{position:fixed;inset:0;background:#000a;z-index:40;display:none;align-items:center;justify-content:center}
#lob.show{display:flex}
#lk{background:#14307a;border:3px solid #f5b301;border-radius:16px;padding:18px;text-align:center;width:min(88vw,360px);font-weight:800;display:flex;flex-direction:column;gap:10px}
#l1,#l2{display:flex;flex-direction:column;gap:10px}
#lk input{font-size:18px;padding:10px;border-radius:8px;border:0;text-align:center}
#rc{text-transform:uppercase}
#lk button{background:#f5b301;font-weight:800}
#rcode{font-size:40px;letter-spacing:6px;color:#ffd54f}
#pl{font-size:16px;line-height:1.6}
#pnl{position:fixed;inset:0;background:#000a;z-index:40;display:none;align-items:center;justify-content:center}
#pnl.show{display:flex}
#pbx{background:#14307a;border:3px solid #f5b301;border-radius:16px;padding:16px;text-align:center;width:min(90vw,380px);max-height:88vh;overflow-y:auto;font-weight:800;display:flex;flex-direction:column;gap:10px}
#pb{display:flex;flex-direction:column;gap:10px}
#pt{font-size:22px;color:#ffd54f}
#pbx button{background:#f5b301;color:#222;font-weight:800;border-radius:10px;padding:10px;font-size:16px}
#pbx button:disabled{opacity:.5}
#pbx input{font-size:18px;padding:10px;border-radius:8px;border:0;text-align:center}
.dy{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.dy div{background:#1e56c6;border-radius:8px;padding:8px 2px;font-size:13px;white-space:pre}
.dy .got{background:#2e7d32}
.dy .now{outline:3px solid #ffd54f}
.rw{display:flex;gap:8px;align-items:center;justify-content:space-between;background:#1e56c6;border-radius:10px;padding:8px 10px}
.avs{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.avs span{font-size:30px;padding:4px;border-radius:10px}
.avs .sel{background:#f5b301}
#login{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:20px;overflow-y:auto;background:radial-gradient(circle at 50% 20%,#3b7bff,#14307a 55%,#0a1647)}
#login.show{display:flex}
#login .lt span{animation:lb 1.6s ease-in-out infinite}
#login .lt span:nth-child(2){animation-delay:.15s}#login .lt span:nth-child(3){animation-delay:.3s}#login .lt span:nth-child(4){animation-delay:.45s}
@keyframes lb{50%{transform:translateY(-10px)}}
#lgd{font-size:60px;animation:lb 2s ease-in-out infinite}
#lgc{background:#0d2160cc;border:3px solid #f5b301;border-radius:20px;padding:18px;width:min(90vw,380px);display:flex;flex-direction:column;gap:12px;text-align:center;font-weight:800;box-shadow:0 8px 30px #0008}
#lgc input{font-size:20px;padding:12px;border-radius:12px;border:0;text-align:center}
#lgc button{font-size:19px;font-weight:900;padding:13px;border-radius:14px;color:#222}
#lgp{background:linear-gradient(#ffd54f,#f5a300);box-shadow:0 4px 0 #8a5a00}
#lgg{background:#cfd8ff}
#lgo{background:#fff;display:flex;gap:10px;align-items:center;justify-content:center}
#lgo b{font-size:22px;color:#4285f4}
#lgb{display:flex;justify-content:center}
.or{font-size:13px;opacity:.7}
#lge{color:#ff8a80;min-height:18px;font-size:14px}
#lgc .avs span{font-size:34px}
#lgc #lfb{background:#1877f2;color:#fff;display:flex;gap:10px;align-items:center;justify-content:center}
#lfb b{font-size:22px}
</style>
</head>
