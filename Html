<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#1b1b2f">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Lodu Family</title>
<style>
*{box-sizing:border-box;margin:0}
body{background:#1b1b2f;color:#fff;font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;gap:10px;padding:8px;min-height:100vh}
#top{display:flex;gap:8px;align-items:center;justify-content:space-between;width:min(96vw,560px)}
select,button{font-size:16px;padding:7px 12px;border-radius:8px;border:0}
#msg{font-weight:700;font-size:18px;text-align:center;min-height:24px}
#board{position:relative;width:min(98vw,calc(100vh - 230px),600px);aspect-ratio:1}
.tok{position:absolute;width:calc(var(--u,4.31%)*.8);height:calc(var(--u,4.31%)*.8);border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #000;transition:left .22s,top .22s;z-index:2}
.tok.done{transform:scale(.6)}
.tok.hl{animation:pulse .6s infinite;box-shadow:0 0 8px 3px #fff;cursor:pointer;z-index:3}
@keyframes pulse{50%{transform:scale(1.4)}}
#dice{width:72px;height:72px;background:#fff;border-radius:12px;display:grid;grid-template:repeat(3,1fr)/repeat(3,1fr);padding:10px;gap:3px;cursor:pointer}
#dice i{border-radius:50%}
#dice i.on{background:#222}
#dice.spin{animation:sp .35s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
#dice{position:absolute;width:calc(var(--u,4.31%)*1.9);height:calc(var(--u,4.31%)*1.9);padding:calc(var(--u,4.31%)*.3);gap:1px;border-radius:18%;transform:translate(-50%,-50%);z-index:4;transition:left .4s,top .4s}
#dice::after{content:"";position:absolute;inset:-25%}
#dice.spin{animation:sp2 .35s linear infinite}
@keyframes sp2{to{transform:translate(-50%,-50%) rotate(360deg)}}
html,body{-webkit-tap-highlight-color:transparent;user-select:none;touch-action:manipulation;overscroll-behavior:none}
input{user-select:text}
#dock{display:flex;gap:14px;align-items:center}
.rb{width:54px;height:54px;border-radius:50%;font-size:26px;background:#2d2d55;position:relative;padding:0;color:#fff}
#mic.live{background:#2e7d32}
#mic.mute{background:#b71c1c}
#mic.speak{box-shadow:0 0 0 5px #66ff66}
#bd{position:absolute;top:-4px;right:-4px;background:#e53935;font-size:12px;border-radius:10px;padding:1px 6px;display:none}
#tray{display:none;gap:8px;flex-wrap:wrap;justify-content:center;max-width:96vw}
#tray.show{display:flex}
.eb{font-size:28px;background:#2d2d55;border-radius:12px;padding:6px 10px}
#chat{position:fixed;left:0;right:0;bottom:0;height:46vh;background:#252545;border-radius:16px 16px 0 0;transform:translateY(100%);transition:transform .25s;display:flex;flex-direction:column;z-index:10;padding:10px;gap:8px}
#chat.open{transform:none}
#cm{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px;font-size:16px}
#cin{display:flex;gap:8px}
#ci{flex:1;font-size:16px;padding:9px;border-radius:8px;border:0}
#toast{position:fixed;top:12px;left:50%;transform:translateX(-50%);background:#000c;padding:8px 14px;border-radius:10px;opacity:0;transition:opacity .3s;z-index:20;pointer-events:none;max-width:90vw;text-align:center}
#toast.show{opacity:1}
.ring{position:absolute;width:calc(var(--u,4.31%)*3.8);height:calc(var(--u,4.31%)*3.8);border-radius:50%;border:3px solid #6f6;opacity:0;pointer-events:none}
.ring.speak{animation:rg .6s infinite}
@keyframes rg{0%{opacity:.9;transform:translate(-50%,-50%) scale(.9)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.4)}}
.ring{transform:translate(-50%,-50%)}
.fl{position:absolute;font-size:min(10vw,52px);z-index:5;pointer-events:none;animation:fup 2s ease-out forwards}
.fl span{display:inline-block}
@keyframes fup{0%{opacity:0;transform:translate(-50%,-30%) scale(.3)}15%{opacity:1;transform:translate(-50%,-60%) scale(1.2)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-170%) scale(1)}}
.a-spin{animation:sp .5s linear 3}
.a-shake{animation:sh .2s infinite}
.a-pulse{animation:pl .4s infinite}
.a-bounce{animation:bn .4s infinite}
@keyframes sh{0%,100%{transform:rotate(18deg)}50%{transform:rotate(-18deg)}}
@keyframes pl{50%{transform:scale(1.4)}}
@keyframes bn{50%{transform:translateY(-.3em)}}
#toast{z-index:50}
#home{position:fixed;inset:0;z-index:30;overflow-y:auto;background:radial-gradient(circle at 50% 28%,#2f66e0,#14307a 70%)}
.hw{max-width:480px;margin:0 auto;min-height:100%;padding:10px 12px 96px;display:flex;flex-direction:column;justify-content:space-around;gap:16px}
.tb{display:flex;align-items:center;gap:8px}
.av{width:46px;height:46px;border-radius:12px;border:3px solid #f5b301;background:#ffd9a8;font-size:28px;display:flex;align-items:center;justify-content:center}
.ib{width:40px;height:40px;border-radius:50%;background:#1f4fc0;color:#fff;font-size:22px;padding:0}
.pill{flex:1;background:#0d2160;border-radius:10px;padding:5px 8px;display:flex;align-items:center;gap:6px;font-size:18px;font-weight:800}
.pill b{flex:1;text-align:right}
.pill i{font-style:normal;background:#2e9d3a;border-radius:6px;padding:0 6px}
.logo{text-align:center}
.crown{font-size:44px;line-height:1}
.lt{display:flex;justify-content:center;gap:4px}
.lt span{width:56px;height:56px;border-radius:50%;border:4px solid #fff;font-size:34px;font-weight:900;display:flex;align-items:center;justify-content:center;text-shadow:0 2px 0 #0006}
.sub{font-weight:800;letter-spacing:3px;color:#ffd54f;margin-top:6px}
.dc{font-size:64px;line-height:1.2}
.row3{display:flex;gap:8px;justify-content:center}
