.mode{flex:1;max-width:150px;border:3px solid #f5b301;border-radius:14px;background:linear-gradient(#2a6be0,#1747ad);padding:0;overflow:hidden;color:#fff;display:flex;flex-direction:column;box-shadow:0 4px 0 #0008}
