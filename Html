<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
let net='local',mySeat=null,conns=[],lastFace=1,vsCpu=false,bt=0;
// Board shape depends on the number of players: 2-4 = square, 5 = star, 6 = hexagon, 7-8 = octagon
let A=8,R=5,D0=4,CH=11,L=88,HC=87,GOAL=91,V=11.6,AP=10.6,RB=8.9;
const PAL={
  4:[['#e53935','Red'],['#43a047','Green'],['#fdd835','Yellow'],['#1e88e5','Blue']],
  5:[['#e53935','Red'],['#fdd835','Yellow'],['#43a047','Green'],['#1e88e5','Blue'],['#8e24aa','Purple']],
  6:[['#e53935','Red'],['#fb8c00','Orange'],['#43a047','Green'],['#00bcd4','Cyan'],['#1e88e5','Blue'],['#8e24aa','Purple']],
  8:[['#e53935','Red'],['#fb8c00','Orange'],['#fdd835','Yellow'],['#43a047','Green'],['#00bcd4','Cyan'],['#1e88e5','Blue'],['#8e24aa','Purple'],['#ec407a','Pink']]
};
let COL=PAL[8].map(x=>x[0]),NAME=PAL[8].map(x=>x[1]);
const SETS={2:[0,2],3:[0,1,2],4:[0,1,2,3],5:[0,1,2,3,4],6:[0,1,2,3,4,5],7:[0,1,2,3,5,6,7],8:[0,1,2,3,4,5,6,7]};
const rad=k=>(-90+360/A*k)*Math.PI/180;
const arm=(k,t,l)=>{const a=rad(k),d=D0+t;return [d*Math.cos(a)-l*Math.sin(a),d*Math.sin(a)+l*Math.cos(a)];};
const cellOf=m=>{const k=Math.floor(m/CH),q=m%CH;return q<R?[k,q,-1]:q===R?[k,R-1,0]:[k,2*R-q,1];};
const SK=k=>k*CH+R+2;
const SAFE=new Set();
const baseXY=k=>{const b=rad(k)+Math.PI/A;return [RB*Math.cos(b),RB*Math.sin(b)];};

let ACT=[],turn=0,rolled=null,busy=false,T={};
const EL=[],rings=[];
const board=document.getElementById('board');
const msg=document.getElementById('msg');
const dice=document.getElementById('dice');
const sleep=ms=>new Promise(r=>setTimeout(r,ms));

function makeTokens(){
  for(let k=0;k<8;k++){
    EL[k]=[];
    for(let i=0;i<4;i++){
      const t=document.createElement('div');t.className='tok';
      t.onclick=()=>move(k,i);
      board.appendChild(t);EL[k].push(t);
    }
  }
}
function outline(){
  const out=[];
  if(A===5){   // star: long arms with notches between them
    const h=Math.PI/A,VAL=RB+2.25;
    for(let k=0;k<A;k++){
      const v=rad(k)-h;out.push([VAL*Math.cos(v),VAL*Math.sin(v)]);
      out.push(arm(k,AP-D0,-1.9));out.push(arm(k,AP-D0,1.9));
    }
  }else{
    const rv=AP/Math.cos(Math.PI/A);
    for(let j=0;j<A;j++){const a=rad(0)+Math.PI/A+2*Math.PI/A*j;out.push([rv*Math.cos(a),rv*Math.sin(a)]);}
  }
  return out;
}
function drawBoard(){
  const poly=outline().map(p=>p[0].toFixed(2)+','+p[1].toFixed(2)).join(' ');
  const rect=(x,y,k,f)=>`<rect x="-.48" y="-.48" width=".96" height=".96" rx=".08" fill="${f}" stroke="#888" stroke-width=".05" transform="translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${360/A*k})"/>`;
  const cr=(D0-.5)/Math.cos(Math.PI/A);
  let W='',ST='';const G=[];
  for(let k=0;k<A;k++){
    const a=rad(k),f=COL[k],h=Math.PI/A;
    const [bx,by]=baseXY(k);
    G[k]=`<polygon points="0,0 ${(cr*Math.cos(a-h)).toFixed(2)},${(cr*Math.sin(a-h)).toFixed(2)} ${(cr*Math.cos(a+h)).toFixed(2)},${(cr*Math.sin(a+h)).toFixed(2)}" fill="${f}"/>`
      +`<circle cx="${bx.toFixed(2)}" cy="${by.toFixed(2)}" r="1.9" fill="${f}"/><circle cx="${bx.toFixed(2)}" cy="${by.toFixed(2)}" r="1.45" fill="#fff"/>`;
    for(let t=0;t<R-1;t++){const [x,y]=arm(k,t,0);G[k]+=rect(x,y,k,f);}
  }
  for(let m=0;m<L;m++){
    const [k,t,l]=cellOf(m);
    const [x,y]=arm(k,t,l);
    let owner=-1;for(let j=0;j<A;j++)if(SK(j)===m)owner=j;
    if(owner>=0)G[owner]+=rect(x,y,k,COL[owner]);else W+=rect(x,y,k,'#fff');
    if(SAFE.has(m))ST+=`<text x="${x.toFixed(2)}" y="${(y+.22).toFixed(2)}" font-size=".7" text-anchor="middle" fill="#555">\u2605</text>`;
  }
  let s=`<svg viewBox="${-V} ${-V} ${2*V} ${2*V}" style="position:absolute;inset:0;width:100%;height:100%">`;
  s+=`<polygon points="${poly}" fill="#fff" stroke="#fff" stroke-width=".3" stroke-linejoin="round"/>`+W;
  for(let k=0;k<A;k++)s+=`<g id="g${k}">${G[k]}</g>`;
  s+=ST+'</svg>';
  const old=board.querySelector('svg');if(old)old.remove();
  board.insertAdjacentHTML('afterbegin',s);
}
function setBoard(n){
  const a=n<=4?4:n===5?5:n===6?6:8;
  if(a===A&&board.querySelector('svg'))return;
  A=a;R=a===4?6:a===5?7:5;D0=a===4?2:a===5?2.5:a===6?3:4;CH=2*R+1;L=A*CH;HC=L-1;GOAL=L+R-2;
  AP=D0+R+1.6;RB=a===4?5.7:a===5?6.3:a===6?7.3:8.9;
  COL=PAL[a].map(x=>x[0]);NAME=PAL[a].map(x=>x[1]);
  const ex=Math.max(...outline().flat().map(Math.abs));
  V=Math.ceil((ex+.4)*10)/10;
  SAFE.clear();for(let k=0;k<A;k++){SAFE.add(SK(k));SAFE.add((SK(k)+8)%L);}
  drawBoard();
  board.style.setProperty('--u',(100/(2*V))+'%');
  for(let k=0;k<8;k++)EL[k].forEach(e=>{e.style.background=COL[k]||'#888';});
  for(let k=0;k<8;k++){
    const r=rings[k];if(!r)continue;
    if(k<A){const [x,y]=baseXY(k);r.style.display='';r.style.left=(x+V)/(2*V)*100+'%';r.style.top=(y+V)/(2*V)*100+'%';}
    else r.style.display='none';
  }
}
